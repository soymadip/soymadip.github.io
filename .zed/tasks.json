// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
[
  {
    "label": "Run Current file",
    "command": "quikrun '${ZED_RELATIVE_FILE}'", // Needs https://pypi.org/p/quikrun/ to be installed
    "save": "current",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "show_summary": false,
    "show_command": false
  },
  {
    "label": "Open writing-agent chat",
    "command": "copilot --resume=$COPILOT_AGENT_CHAT_ID",
    "use_new_terminal": true,
    "hide": "on_success",
    "reveal_target": "center"
  },
  {
    "label": "Run Dev server",
    "command": "mise run dev",
    "save": "current",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "show_summary": true,
    "show_command": true
  }
]
