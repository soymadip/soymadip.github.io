// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
[
  {
    "label": "Run Current file",
    "command": "clear && ./static/run-code ${ZED_RELATIVE_FILE}",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "current",
  },
  {
    "label": "Open writing-agent chat",
    "command": "copilot --resume=$COPILOT_AGENT_CHAT_ID",
    "use_new_terminal": true,
    "hide": "on_success",
    "reveal_target": "center",
  },
]
