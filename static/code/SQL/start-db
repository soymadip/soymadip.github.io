#!/usr/bin/env bash

export COMPOSE_PROJECT_NAME="practice-db"

export DB_DATABASE="$COMPOSE_PROJECT_NAME"
export DB_SU_PASSWORD="my-secret-pw"

#
# Build Compose Command
COMPOSE=()

if command -v podman >/dev/null 2>&1; then
  if podman compose version >/dev/null 2>&1; then
    echo "Using: podman compose"
    COMPOSE=(podman compose)
  elif command -v podman-compose >/dev/null 2>&1; then
    echo "Using: podman-compose"
    COMPOSE=(podman-compose)
  fi
fi

# Check for Docker when Podman was not selected.
if ((${#COMPOSE[@]} == 0)) && command -v docker >/dev/null 2>&1; then
  if docker compose version >/dev/null 2>&1; then
    echo "Using: docker compose"
    COMPOSE=(docker compose)
  elif command -v docker-compose >/dev/null 2>&1; then
    echo "Using: docker-compose"
    COMPOSE=(docker-compose)
  fi
fi

if ((${#COMPOSE[@]} == 0)); then
  echo "Error: Neither Podman nor Docker with compose support was found." >&2
  exit 1
fi

case "${1:-}" in
down | stop | restart | ps | logs)
  command="$1"
  shift
  exec "${COMPOSE[@]}" "$command" "$@"
  ;;
*)
  exec "${COMPOSE[@]}" up --pull always --remove-orphans "$@"
  ;;
esac
