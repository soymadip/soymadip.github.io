#!/usr/bin/env bash

export MARIADB_ROOT_PASSWORD="my-secret-pw"
export MARIADB_DATABASE="practice_db"

export PMA_USER="root"
export PMA_PASSWORD="$MARIADB_ROOT_PASSWORD"

ARGS="up --no-recreate --remove-orphans"

# Check for Podman
if command -v podman >/dev/null 2>&1; then
    if podman compose version >/dev/null 2>&1; then
        echo "Using: podman compose"
        exec podman compose $ARGS "$@"
    elif command -v podman-compose >/dev/null 2>&1; then
        echo "Using: podman-compose"
        exec podman-compose $ARGS "$@"
    fi
fi

# Check for Docker
if command -v docker >/dev/null 2>&1; then
    if docker compose version >/dev/null 2>&1; then
        echo "Using: docker compose"
        exec docker compose $ARGS "$@"
    elif command -v docker-compose >/dev/null 2>&1; then
        echo "Using: docker-compose"
        exec docker-compose $ARGS "$@"
    fi
fi

echo "Error: Neither Podman nor Docker with compose support was found." >&2
exit 1